[Unit]
Description=VLive Docs CICD dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/vtvlive/vlive-docs-server
EnvironmentFile=/home/vtvlive/vlive-docs-server/.env
ExecStart=/usr/bin/node /home/vtvlive/vlive-docs-server/src/server.js
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
