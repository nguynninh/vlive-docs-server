[Unit]
Description=VLive Docs CICD dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/vtvlive/cicd
EnvironmentFile=/home/vtvlive/cicd/.env
ExecStart=/usr/bin/node /home/vtvlive/cicd/src/server.js
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
